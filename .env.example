# For running this locally to try it out. On Render you enter these in the dashboard instead.
# Never commit a real .env file.
PORT=10000
PUBLIC_URL=http://127.0.0.1:10000
TELLER_ENV=sandbox
TELLER_DATA_DIR=./data
TELLER_APPLICATION_ID=app_xxxxxxxx
# Generate each secret with:  openssl rand -base64 32
MCP_BEARER_TOKEN=
TELLER_STORE_KEY=
# Not needed in sandbox. Required for development and production:
# TELLER_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# TELLER_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
